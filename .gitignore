# Create a standard .gitignore file suitable for a Node.js / Vite / React project
gitignore_content = """# Node / npm / yarn / pnpm dependencies
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment & local config files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Production build outputs
dist/
dist-ssr/
build/
*.local

# IDE & Editor files
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvsopt
*.njsproj
*.sln
*.sw?

# OS metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs & cache
logs/
*.log
.eslintcache
.stylelintcache
.vite/
.cache/

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# Service Worker / PWA temporary builds
public/sw.js.map
"""

with open(".gitignore", "w", encoding="utf-8") as f:
    f.write(gitignore_content)

print("Created .gitignore file successfully.")